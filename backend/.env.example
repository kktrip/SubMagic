# Anthropic API Key (for frame analysis with Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace Token (for pyannote speaker diarization)
# Get from: https://huggingface.co/settings/tokens
# Also accept terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Whisper model size: tiny, base, small, medium, large
# Larger = more accurate but slower
WHISPER_MODEL=base

# Frame extraction interval in seconds (extract one frame every N seconds)
FRAME_INTERVAL=30

# Upload size limit in MB
MAX_UPLOAD_SIZE_MB=500
