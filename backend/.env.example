# ── 画面分析プロバイダー ──────────────────────────────────────────────────────
# gemini  → Google Gemini API（無料・おすすめ）
# ollama  → Ollama ローカル実行（完全無料・APIキー不要）
# claude  → Anthropic Claude API（有料）
VISION_PROVIDER=gemini

# Google Gemini API キー（VISION_PROVIDER=gemini のとき必要）
# 無料で取得: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic API キー（VISION_PROVIDER=claude のとき必要）
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 設定（VISION_PROVIDER=ollama のとき）
# 事前に `ollama pull llava` を実行しておく
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# ── 話者識別 ─────────────────────────────────────────────────────────────────
# HuggingFace Token（pyannote speaker diarization に必要）
# 無料で取得: https://huggingface.co/settings/tokens
# 利用規約への同意も必要: https://huggingface.co/pyannote/speaker-diarization-3.1
# 未設定の場合は全セグメントが「Speaker A」になります
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── Whisper ──────────────────────────────────────────────────────────────────
# モデルサイズ: tiny / base / small / medium / large
# 日本語は small 以上を推奨
WHISPER_MODEL=base

# ── その他 ───────────────────────────────────────────────────────────────────
# 何秒おきに1フレーム抽出するか
FRAME_INTERVAL=30

# アップロード上限（MB）
MAX_UPLOAD_SIZE_MB=500
